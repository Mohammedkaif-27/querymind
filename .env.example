# Groq LLM API Key (Required)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Supabase Credentials (Required)
# Get these from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Direct Postgres DB URL (Required for dynamic table creation)
# Supabase Dashboard -> Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# Optional Configuration Defaults
DB_PATH=data/northwind.db
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
TOP_K_TABLES=3
MAX_RETRIES=3
RESULT_LIMIT=100
QUERY_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional Remote ChromaDB Server URL (leave blank for embedded local Chroma)
CHROMA_URL=

# Embedding Provider: "local" (default) or "openrouter" (for cloud deployment)
# When set to "huggingface", embeddings are generated via the HuggingFace API
# instead of loading PyTorch locally. This prevents OOM crashes on low-memory hosts.
EMBEDDING_PROVIDER=huggingface

# HuggingFace (used for Embeddings & Reranking)
HUGGINGFACE_API_KEY=your_hf_api_key_here
RERANKER_MODEL=BAAI/bge-reranker-base
